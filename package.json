  "scripts": {
    "dev": "next dev",
    "dev:all": "tsx scripts/dev-all.ts",
    "setup:local": "tsx scripts/dev-all.ts --setup-only",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p .railway",
    "test": "vitest run",
    "db:start": "tsx scripts/db-start.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "tsx scripts/db-check.ts",
    "db:seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "ingest": "tsx scripts/ingest.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "screenshots": "tsx scripts/screenshots.ts",
    "screenshots:real": "tsx scripts/screenshots-real.ts",
    "screenshots:graph": "tsx scripts/screenshots-graph.ts",
    "logos": "tsx scripts/fetch-logos.ts",
    "graph:verify": "tsx scripts/verify-graph.ts",
    "start:prod": "node scripts/start.mjs"
  },
  "dependencies": {
    "@category-labs/mera": "^0.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@upstash/redis": "^1.39.0",
    "aws4fetch": "1.0.20",
    "lucide-react": "^1.57.0",
    "next": "15.5.28",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "17.10.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright-core": "^1.64.1",
    "railway": "3.16.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
