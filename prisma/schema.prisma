// Corridor (working name) — local dev uses SQLite.
// To move to Postgres: change provider to "postgresql" and DATABASE_URL.
// List-like fields (chains, aliases) are stored as JSON-encoded strings so the
// schema works identically on SQLite and Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  handle             String   @unique
  role               String   @default("")
  orgName            String   @default("")
  orgId              String?
  org                Organization? @relation("Members", fields: [orgId], references: [id])
  bio                String   @default("")
  /// Free-text description of how the user writes; fed to the AI scout.
  voice              String   @default("")
  locale             String   @default("en")
  /// Placeholder for future wallet / Farcaster / LinkedIn verification.
  verified           Boolean  @default(false)
  verificationMethod String?
  createdAt          DateTime @default(now())

  sessions     Session[]
  workspaces   Workspace[]
  posts        Post[]
  activities   Activity[]
  drafts       ScoutDraft[]
  signals      Signal[]
  followsOrgs  FollowOrg[]
  following    FollowUser[] @relation("Follower")
  followers    FollowUser[] @relation("Followee")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model MagicLink {
  token     String    @id
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Organization {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  type             String
  country          String   @default("")
  region           String   @default("")
  website          String   @default("")
  /// JSON string[]
  aliases          String   @default("[]")
  /// JSON string[] — only publicly confirmed chains
  chainsInUse      String   @default("[]")
  /// JSON string[]
  chainsEvaluating String   @default("[]")
  notes            String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members   User[]       @relation("Members")
  deals     Deal[]
  signals   SignalOrg[]
  posts     PostOrg[]
  followers FollowOrg[]
  drafts    ScoutDraft[]
  advisingOn Advisor[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  deals     Deal[]
}

model Deal {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stage           String    @default("awareness")
  useCase         String    @default("")
  nextAction      String    @default("")
  nextActionDue   DateTime?
  /// JSON string[] — chains this institution is evaluating in competition
  competingChains String    @default("[]")
  lostReason      String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contacts   Contact[]
  advisors   Advisor[]
  activities Activity[]

  @@unique([workspaceId, orgId])
}

model Contact {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name       String
  title      String   @default("")
  email      String   @default("")
  isChampion Boolean  @default(false)
  notes      String   @default("")
  createdAt  DateTime @default(now())
}

model Advisor {
  id           String   @id @default(cuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name         String
  firm         String   @default("")
  /// Optional link to an advisor org in the directory (consultancy, law firm…)
  advisorOrgId String?
  advisorOrg   Organization? @relation(fields: [advisorOrgId], references: [id])
  influence    String   @default("medium")
  notes        String   @default("")
  createdAt    DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  kind      String   @default("note")
  body      String
  createdAt DateTime @default(now())
}

model ScoutDraft {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  locale    String   @default("en")
  fit       String
  /// JSON string[]
  angles    String   @default("[]")
  subject   String
  draft     String
  createdAt DateTime @default(now())
}

model RssFeed {
  id            String    @id @default(cuid())
  url           String    @unique
  name          String
  enabled       Boolean   @default(true)
  lastFetchedAt DateTime?
  lastError     String?
}

model Signal {
  id          String   @id @default(cuid())
  source      String   @default("manual")
  sourceName  String   @default("")
  title       String
  url         String?  @unique
  summary     String   @default("")
  publishedAt DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  orgs        SignalOrg[]
}

model SignalOrg {
  signalId String
  signal   Signal       @relation(fields: [signalId], references: [id], onDelete: Cascade)
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([signalId, orgId])
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  orgs      PostOrg[]
}

model PostOrg {
  postId String
  post   Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([postId, orgId])
}

model FollowOrg {
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@id([userId, orgId])
}

model FollowUser {
  followerId String
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
}
