# Copy to .env for local development. Production values live in Railway variables, never in git.
# The server refuses to start in production when a required value is missing (src/lib/env.ts).

# --- Database (PostgreSQL) ---
# Local: `npm run db:start` runs an embedded Postgres on 127.0.0.1:54329 (no Docker needed).
# Railway: reference the Postgres service, ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://connect:connect-local-only@127.0.0.1:54329/connect

# --- Mera passkey sign-in (same variable names as EmpowerTours Hunt) ---
# HMAC key for the session cookie. Random, at least 32 characters. Required in production.
AUTH_SESSION_SECRET=
# WebAuthn relying-party id. Production MUST be the shared parent empowertours.xyz:
# every EmpowerTours app (Hunt, TURBO, Connect, ...) uses this rpId and the same PRF
# salt, so one passkey is one wallet everywhere. A per-host value such as
# connect.empowertours.xyz is refused (it would mint a different wallet).
# It is inlined at build time: set it before building. Leave unset for localhost dev.
NEXT_PUBLIC_RP_ID=
# Upstash Redis: single-use login nonces and shared rate limits. Required in production.
# Without it (dev), rate limits use process memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin ---
# Comma-separated wallet addresses allowed to review org claims, org requests,
# reports and feeds at /admin. Requires a passkey (Mera) session for that wallet.
ADMIN_WALLETS=

# --- Uploads (profile photos) ---
# "local" (disk; default) or "s3" (any S3-compatible bucket; Cloudflare R2 recommended).
STORAGE_DRIVER=local
# local: directory for photos. Dev default .data/uploads. In production it must be an
# absolute path on a mounted Railway volume (e.g. /data/uploads).
UPLOADS_DIR=
# s3: R2 endpoint is https://<account id>.r2.cloudflarestorage.com, region "auto".
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- News ingest (optional) ---
# Feeds refresh in the background when someone opens Today or Signals and they are older
# than 6 hours. Set this (32+ chars) only if an external scheduler should call
# POST /api/cron/ingest with "Authorization: Bearer <secret>".
CRON_SECRET=

# --- Deploy (optional) ---
# Run the base seed (orgs, feeds, channels; never people) on boot. Use for the first deploy only.
# SEED_ON_BOOT=1

# --- Optional: AI scout (uses template drafts when neither is set) ---
# SCOUT_PROVIDER=mock|openai|anthropic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Local only ---
# Allow the one-click dev login in a production build. Refused by the production boot check.
# ALLOW_DEV_LOGIN=1
