# Copy to .env for local development. Production values live in Railway variables, never in git.
# The server refuses to start in production when a required value is missing (src/lib/env.ts).

# --- Database (PostgreSQL) ---
# Local: `npm run db:start` runs an embedded Postgres on 127.0.0.1:54329 (no Docker needed).
# Railway: reference the Postgres service, ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://connect:connect-local-only@127.0.0.1:54329/connect

# --- Mera passkey sign-in (same variable names as EmpowerTours Hunt) ---
# HMAC key for the session cookie. Random, at least 32 characters. Required in production.
AUTH_SESSION_SECRET=
# WebAuthn relying-party id. Production MUST be the shared parent empowertours.xyz:
# every EmpowerTours app (Hunt, TURBO, Connect, ...) uses this rpId and the same PRF
# salt, so one passkey is one wallet everywhere. A per-host value such as
# connect.empowertours.xyz is refused (it would mint a different wallet).
# It is inlined at build time: set it before building. Leave unset for localhost dev.
NEXT_PUBLIC_RP_ID=
# Upstash Redis: single-use login nonces and shared rate limits. Required in production.
# Without it (dev), rate limits use process memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin ---
# Comma-separated wallet addresses allowed to review org claims, org requests,
# reports and feeds at /admin. Requires a passkey (Mera) session for that wallet.
ADMIN_WALLETS=

# --- Uploads (profile photos) ---
# "local" (disk; default) or "s3" (any S3-compatible bucket; Cloudflare R2 recommended).
STORAGE_DRIVER=local
# local: directory for photos. Dev default .data/uploads. In production it must be an
# absolute path on a mounted Railway volume (e.g. /data/uploads).
UPLOADS_DIR=
# s3: R2 endpoint is https://<account id>.r2.cloudflarestorage.com, region "auto".
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- News ingest (optional) ---
# Feeds refresh in the background when someone opens Today or Signals and they are older
# than 6 hours. Set this (32+ chars) only if an external scheduler should call
# POST /api/cron/ingest with "Authorization: Bearer <secret>".
CRON_SECRET=

# --- Deploy (optional) ---
# Run the base seed (orgs, feeds, channels; never people) on boot. Use for the first deploy only.
# SEED_ON_BOOT=1

# --- Cold-start importers (optional) ---
# Farcaster follows: the public hub by default (src/lib/importers/farcaster.ts). Set a Neynar key to
# use Neynar instead (finds verified addresses too), or point FARCASTER_HUB_URL at another hub.
# FARCASTER_HUB_URL=
# NEYNAR_API_KEY=
# Wallet starter packs read Monad mainnet through the public RPC unless this is set.
# MONAD_RPC_URL=

# --- Connect ID on Monad (optional; OFF by default) ---
# Off: everything works off-chain as before and the /api/v1 protocol routes return 404.
# PROTOCOL_ENABLED=1
# 10143 = Monad testnet (default), 20143 = local Monad Solonet. 143 (mainnet) is refused.
# PROTOCOL_CHAIN_ID=10143
# Default per chain: https://rpc-testnet.monadinfra.com (10143), http://localhost:8080 (20143).
# Separate from MONAD_RPC_URL above, which reads Monad mainnet for starter packs.
# PROTOCOL_RPC_URL=
# Contract addresses come from deployments/monad-testnet.json (10143) or the Solonet dry-run
# file contracts/deployments/monad-testnet-dryrun-solonet.json (20143). Override the path:
# PROTOCOL_DEPLOYMENT_FILE=
#
# Sponsored gas runs in a SEPARATE relayer service (same image, start: node relayer.cjs).
# The web app never holds the relayer key; it forwards signed requests over the private network.
# Without RELAYER_URL + RELAYER_SERVICE_TOKEN members get calldata to submit from any wallet.
# Web app:
# RELAYER_URL=http://connect-relayer.railway.internal:8080
# RELAYER_SERVICE_TOKEN=            # 32+ random chars, same value on both services
#
# Relayer service only (setting RELAYER_KEY / RELAYER_KEY_FILE on the web app is an error):
# Its own hot wallet, never the deployer/guardian. Key is a Railway secret (RELAYER_KEY) or a
# 0600 file outside the repo (RELAYER_KEY_FILE), not both. Never commit it.
# Also needs PROTOCOL_ENABLED=1, PROTOCOL_CHAIN_ID, RELAYER_SERVICE_TOKEN and DATABASE_URL (same Postgres).
# RELAYER_KEY=
# RELAYER_KEY_FILE=
# Limits can only be LOWERED from the approved values (design section 6):
# RELAYER_BALANCE_CAP_MON=100
# RELAYER_DAILY_CAP_MON=50
# RELAYER_ALERT_BALANCE_MON=30
# RELAYER_ACCOUNT_TX_PER_DAY=10
# RELAYER_IP_SIGNUPS_PER_DAY=3
# RELAYER_INVITER_SIGNUPS_PER_DAY=20
# RELAYER_MAX_TX_COST_MON=0.5
# RELAYER_MAX_GAS_PRICE_GWEI=250

# --- Error reporting (optional) ---
# Errors are always logged as JSON lines (LOG_LEVEL: debug | info | warn | error; default info).
# Set a Sentry DSN to also send server errors to Sentry (no SDK; one HTTPS request per error).
# Leave empty to disable. A malformed value only produces a boot warning.
SENTRY_DSN=
# LOG_LEVEL=info
# Defaults: Railway environment name and git commit.
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=

# --- Optional: AI scout (uses template drafts when neither is set) ---
# SCOUT_PROVIDER=mock|openai|anthropic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Local only ---
# Allow the one-click dev login in a production build. Refused by the production boot check.
# ALLOW_DEV_LOGIN=1
