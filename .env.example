DATABASE_URL="file:./dev.db"
# Optional — the AI scout uses a mock provider when neither is set.
# SCOUT_PROVIDER=mock|openai|anthropic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Allow the one-click dev login in a production build (local only)
# ALLOW_DEV_LOGIN=1

# --- Mera passkey sign-in (same variable names as EmpowerTours Hunt) ---
# HMAC key for the session cookie. Random, at least 32 characters. Required for Mera sign-in.
AUTH_SESSION_SECRET=
# WebAuthn relying-party id: connect.empowertours.xyz in production (or the parent
# empowertours.xyz to share passkeys across EmpowerTours apps). Defaults to localhost.
NEXT_PUBLIC_RP_ID=
# Upstash Redis for single-use login nonces. Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
