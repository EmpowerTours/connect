DATABASE_URL="file:./dev.db"
# Optional — the AI scout uses a mock provider when neither is set.
# SCOUT_PROVIDER=mock|openai|anthropic
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Allow the one-click dev login in a production build (local only)
# ALLOW_DEV_LOGIN=1

# --- Mera passkey sign-in (same variable names as EmpowerTours Hunt) ---
# HMAC key for the session cookie. Random, at least 32 characters. Required for Mera sign-in.
AUTH_SESSION_SECRET=
# WebAuthn relying-party id. Production MUST be the shared parent empowertours.xyz:
# every EmpowerTours app (Hunt, TURBO, Connect, ...) uses this rpId and the same PRF
# salt, so one passkey is one wallet everywhere. A per-host value such as
# connect.empowertours.xyz is refused (it would mint a different wallet).
# Leave unset for localhost dev; a tunnel/preview host is allowed for testing only.
NEXT_PUBLIC_RP_ID=
# Upstash Redis for single-use login nonces. Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin ---
# Comma-separated wallet addresses allowed to review org claims, org requests
# and reports at /admin. Requires a passkey (Mera) session for that wallet.
ADMIN_WALLETS=

# --- Uploads (profile photos) ---
# Storage driver: "local" (disk, default) for dev. S3/R2 drivers are not implemented yet.
STORAGE_DRIVER=
# Local driver directory (default: .data/uploads, gitignored).
UPLOADS_DIR=
